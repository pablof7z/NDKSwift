{
    "configurations": [
        {
            "name": "Build with bun",
            "request": "launch",
            "cwd": "ndk-hooks",
            "runtimeArgs": [
                "run",
                "build"
            ]
        },
        {
            "name": "Attach to Hermes application",
            "request": "attach",
            "type": "reactnativedirect",
            "cwd": "${workspaceFolder}"
        },
        {
            "type": "node",
            "request": "launch",
            "name": "Debug Vitest with Bun",
            "program": "${workspaceFolder}/node_modules/vitest/vitest.mjs",
            "runtimeExecutable": "bun",
            "args": [
                "--run",
                "--inspect-brk"
            ],
            "autoAttachChildProcesses": true,
            "cwd": "${workspaceFolder}",
            "console": "integratedTerminal"
        },
        {
            "type": "swift",
            "request": "launch",
            "args": [],
            "cwd": "${workspaceFolder:NDKSwift}",
            "name": "Debug outbox-debug",
            "program": "${workspaceFolder:NDKSwift}/.build/debug/outbox-debug",
            "preLaunchTask": "swift: Build Debug outbox-debug"
        },
        {
            "type": "swift",
            "request": "launch",
            "args": [],
            "cwd": "${workspaceFolder:NDKSwift}",
            "name": "Release outbox-debug",
            "program": "${workspaceFolder:NDKSwift}/.build/release/outbox-debug",
            "preLaunchTask": "swift: Build Release outbox-debug"
        },
        {
            "type": "swift",
            "request": "launch",
            "args": [],
            "cwd": "${workspaceFolder:NDKSwift}",
            "name": "Debug test-publisher",
            "program": "${workspaceFolder:NDKSwift}/.build/debug/test-publisher",
            "preLaunchTask": "swift: Build Debug test-publisher"
        },
        {
            "type": "swift",
            "request": "launch",
            "args": [],
            "cwd": "${workspaceFolder:NDKSwift}",
            "name": "Release test-publisher",
            "program": "${workspaceFolder:NDKSwift}/.build/release/test-publisher",
            "preLaunchTask": "swift: Build Release test-publisher"
        },
        {
            "type": "swift",
            "request": "launch",
            "args": [],
            "cwd": "${workspaceFolder:NDKSwift}",
            "name": "Debug TestPublisher",
            "program": "${workspaceFolder:NDKSwift}/.build/debug/TestPublisher",
            "preLaunchTask": "swift: Build Debug TestPublisher"
        },
        {
            "type": "swift",
            "request": "launch",
            "args": [],
            "cwd": "${workspaceFolder:NDKSwift}",
            "name": "Release TestPublisher",
            "program": "${workspaceFolder:NDKSwift}/.build/release/TestPublisher",
            "preLaunchTask": "swift: Build Release TestPublisher"
        },
        {
            "type": "swift",
            "request": "launch",
            "args": [],
            "cwd": "${workspaceFolder:NDKSwift}",
            "name": "Debug OutboxDebugger",
            "program": "${workspaceFolder:NDKSwift}/.build/debug/OutboxDebugger",
            "preLaunchTask": "swift: Build Debug OutboxDebugger"
        },
        {
            "type": "swift",
            "request": "launch",
            "args": [],
            "cwd": "${workspaceFolder:NDKSwift}",
            "name": "Release OutboxDebugger",
            "program": "${workspaceFolder:NDKSwift}/.build/release/OutboxDebugger",
            "preLaunchTask": "swift: Build Release OutboxDebugger"
        }
    ]
}